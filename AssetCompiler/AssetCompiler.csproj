
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AssetCompiler</AssemblyName>
    <RootNamespace>AssetCompiler</RootNamespace>
    <!-- WPF 必须关闭 globalization-invariant 模式（t15 修复，勿改回 true）：
         WPF 文本排版链路 TextFormatterImp -> SimpleRun -> FontFaceLayoutInfo.ComputeTypographyAvailabilities
         -> MS.Internal.FontCache.MajorLanguages 需要真实 CultureInfo；invariant 模式下该静态构造器抛
         CultureNotFoundException（Only the invariant culture is supported in globalization-invariant mode），
         GUI 启动即以 0xE0434352 未处理异常退出，且每个文本元素抛一次。
         该配置项只适用于控制台工程（例如 InvokerSmokeTest）。 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RollForward>LatestMajor</RollForward>
    <!-- t28o：不使用 EnableDefaultCompileItems——默认 glob 已排除 bin/obj，
         AssemblyInfo 重复（CS0579）问题不存在；显式列举反而会漏编根目录新文件。 -->
  </PropertyGroup>



  <!-- 全局 using：本工程源码（MainWindow/Services/Models）不写 using System.IO 等，
       靠这里提供；与 ImplicitUsings 默认集有重叠但合法（重复 global using 不报错）。 -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Text" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
  </ItemGroup>
  <!-- t18：DLL 调用层抽到独立 SDK 工程；UI 只面对 SDK 的托管 API，不再直接 P/Invoke -->
  <ItemGroup>
    <ProjectReference Include="..\SDK\SDK.csproj" />
  </ItemGroup>
</Project>
