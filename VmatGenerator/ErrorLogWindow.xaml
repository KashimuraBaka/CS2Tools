<Window x:Class="VmatGenerator.ErrorLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="错误日志"
        Height="560" Width="1080"
        MinHeight="360" MinWidth="760"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 说明条 -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="12"
                Background="{DynamicResource LayerFillColorAltBrush}"
                CornerRadius="6">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="控件错误记录" />
                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="应用中的每个控件操作都被 ErrorLog 组件包裹：一旦某个控件出错，错误会被记录到下表与磁盘日志，而应用不会退出。" />
                <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                           Text="{Binding LogPathText, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Border>

        <!-- 记录列表 -->
        <DataGrid Grid.Row="1" x:Name="EntriesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  FontSize="12">
            <!-- 与主窗口贴图列表同一处修复：不用系统高亮色画选中带，
                 否则窗口失焦时选中行会变成一条白色横带、文字变浅灰。 -->
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#663A7BD9" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#333A7BD9" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8E8E8" />
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间"   Binding="{Binding TimeText}"     Width="180" />
                <DataGridTextColumn Header="级别"   Binding="{Binding SeverityText}" Width="60"  />
                <DataGridTextColumn Header="操作"   Binding="{Binding Operation}"    Width="180" />
                <DataGridTextColumn Header="控件"   Binding="{Binding Control}"      Width="320" />
                <DataGridTextColumn Header="异常"   Binding="{Binding ExceptionType}" Width="220" />
                <DataGridTextColumn Header="消息"   Binding="{Binding Message}"      Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 详情 -->
        <Expander Grid.Row="2" Margin="0,10,0,0" Header="选中记录的完整堆栈">
            <TextBox x:Name="DetailBox" Margin="6"
                     Height="140"
                     IsReadOnly="True"
                     FontFamily="Cascadia Mono, Consolas, 微软雅黑"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Expander>

        <!-- 操作按钮 -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Opacity="0.7" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ClearButton"  Content="清空"     Margin="6,0,0,0" Click="OnClearClicked" />
                <Button x:Name="FolderButton" Content="打开日志目录" Margin="6,0,0,0" Click="OnOpenFolderClicked" />
                <Button x:Name="CopyButton"   Content="复制选中"  Margin="6,0,0,0" Click="OnCopyClicked" />
                <Button x:Name="CloseButton"  Content="关闭"      Margin="6,0,0,0" IsDefault="True" Click="OnCloseClicked" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>