<Window x:Class="VmatGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VmatGenerator.ViewModels"
        mc:Ignorable="d"
        Title="VmatGenerator · 贴图快速导航"
        Width="1280" Height="900"
        MinWidth="1060" MinHeight="820"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        DragEnter="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop">
    <!-- 主窗口自己就是根：ViewModel 由 XAML 直接建立，不再由别的窗口 new 进来。 -->
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <!--
        无边框自绘标题栏：WindowStyle=None 之后用 WindowChrome 把「拖动 / 边缘缩放 /
        Win11 原生圆角与阴影 / 贴边分屏 / Win+方向键」这些系统行为全部保留下来，
        只去掉系统画的标题栏本身。CaptionHeight=40 声明顶部 40px 是可拖动的标题区，
        其上的可交互控件（三个按钮）需要 WindowChrome.IsHitTestVisibleInChrome=True
        才会从「拖动区」里豁免出来；其余空白处仍可拖动窗口。
        方案即 MS 文档推荐做法：https://learn.microsoft.com/dotnet/desktop/wpf/window-customization
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 所有单元格内容统一垂直 + 水平居中。
             「后缀名」是编辑框、「语义槽位」是下拉框，二者默认会纵向拉伸到整行高度；
             缩略图与复选框则会被顶到左上角。用 Cell 级样式一次覆盖全部列，
             比逐列加 HorizontalAlignment / VerticalAlignment 更不容易漏。
             居中不破坏长文件名的截断：DataGridCell 仍以可用宽度去测量内容，
             TextBlock 的 TextTrimming 照常生效，只是把测量结果居中摆放。 -->
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- 当前步骤的高亮。刻意用本地画刷而不是 DynamicResource：
             AccentFillColorDefaultBrush 这类主题键在本项目里并无定义（DynamicResource
             解析不到只会静默变透明，不会报错），自己定义才能保证高亮一定显示得出来。 -->
        <SolidColorBrush x:Key="StepActiveBrush" Color="#FF3A7BD9" Opacity="0.28" />
        <SolidColorBrush x:Key="StepActiveBorderBrush" Color="#FF3A7BD9" Opacity="0.85" />
        <!-- 步骤条基础样式：只放公共外观，<b>不放任何触发器</b>。
             三个格子共用本样式，「谁是当前步骤」必须逐格判断：触发器写进共用样式的话
             每个格子都会命中 1/2/3 之一 → 三格同时高亮，等于没有高亮（原实现的毛病）。
             当前步骤的判断放在下面 Step1/2/3ItemStyle 三个派生样式里，各自只认自己的值。

             Opacity 走低亮对比：非当前步骤整块变暗（底色本就透明，暗的是文字与图标）。
             用元素自己的 Opacity 而不是继承的 Foreground —— Fluent 主题的隐式
             TextBlock 样式自带 Foreground 设值器，优先级高于继承，灰色会被静默覆盖。 -->
        <Style x:Key="StepItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <!-- 未到过的步骤也可点击（向导允许跳回去改），点击行为挂在各自格子的事件上。 -->
        <Style x:Key="Step1ItemStyle" TargetType="Border" BasedOn="{StaticResource StepItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StepIndex}" Value="1">
                    <Setter Property="Background" Value="{StaticResource StepActiveBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StepActiveBorderBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Step2ItemStyle" TargetType="Border" BasedOn="{StaticResource StepItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StepIndex}" Value="2">
                    <Setter Property="Background" Value="{StaticResource StepActiveBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StepActiveBorderBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Step3ItemStyle" TargetType="Border" BasedOn="{StaticResource StepItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StepIndex}" Value="3">
                    <Setter Property="Background" Value="{StaticResource StepActiveBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StepActiveBorderBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ─── 自绘标题栏按钮 ──────────────────────────────────────────────
             三个按钮共用一套模板：整块矩形、图标居中、无系统边框。悬停/按下状态
             用主题资源（跟随浅色 / 深色），关闭按钮悬停用 Win11 同款红色并转白字。
             图标来自系统自带的 Segoe Fluent Icons（老系统回退 Segoe MDL2 Assets）。 -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Win11 关闭按钮同款：悬停变红底白字，按下更深一档。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFC42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#FFC83B2C" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 最大化按钮的图标 / 提示 / 无障碍名跟随窗口状态切换（最大化后显示「还原」双框图标）。
             默认图标也放在 Style 里：若写在元素属性上，本地值优先级高于 Style 触发器，
             状态切换就会被静默吃掉。 -->
        <Style x:Key="MaximizeCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Content" Value="&#xE922;" />
            <Setter Property="ToolTip" Value="最大化" />
            <Setter Property="AutomationProperties.Name" Value="最大化" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;" />
                    <Setter Property="ToolTip" Value="还原" />
                    <Setter Property="AutomationProperties.Name" Value="还原" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- ─── 自绘标题栏 ──────────────────────────────────────────────────
             替代系统标题栏（WindowStyle=None + WindowChrome）。整行高 40px 落在
             CaptionHeight 内 → 空白处可直接拖动窗口；右侧三个按钮声明了
             IsHitTestVisibleInChrome，从拖动区豁免、正常响应点击。 -->
        <Grid DockPanel.Dock="Top" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />      <!-- 标题（可拖动区） -->
                <ColumnDefinition Width="Auto" />   <!-- 窗口按钮 -->
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="VmatGenerator · 贴图快速导航"
                       Margin="12,0,0,0"
                       FontSize="{DynamicResource CaptionTextBlockFontSize}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                        ToolTip="最小化" Click="OnMinimizeClicked"
                        AutomationProperties.Name="最小化" />
                <!-- 图标 / 提示 / 无障碍名都在 MaximizeCaptionButtonStyle 内定义，触发器才能切换。 -->
                <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButtonStyle}"
                        Click="OnMaximizeRestoreClicked" />
                <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;"
                        ToolTip="关闭" Click="OnCloseClicked"
                        AutomationProperties.Name="关闭" />
            </StackPanel>
        </Grid>
        <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 步骤条 -->
            <RowDefinition Height="*" />      <!-- 步骤内容 -->
            <RowDefinition Height="Auto" />   <!-- 底部导航 -->
        </Grid.RowDefinitions>
        <!-- ─── 步骤条 ────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Step1ItemStyle}">
                    <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="OnStep1Clicked">
                        <TextBlock Text="①" FontSize="16" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="选择目标" />
                            <TextBlock FontSize="11" Opacity="0.7" Text="着色器 · 资产文件夹 · 项目文件夹" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Step2ItemStyle}">
                    <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="OnStep2Clicked">
                        <TextBlock Text="②" FontSize="16" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="扫描与归类" />
                            <TextBlock FontSize="11" Opacity="0.7" Text="贴图列表 · 指定归属 · 预览" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Step3ItemStyle}">
                    <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="OnStep3Clicked">
                        <TextBlock Text="③" FontSize="16" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="生成" />
                            <TextBlock FontSize="11" Opacity="0.7" Text="进度 · 当前工作" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <!-- ─── 第一步：选择着色器与两个目录 ───────────────────────────────── -->
        <Border Grid.Row="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StepIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Padding="16" CornerRadius="6" Background="{DynamicResource LayerFillColorAltBrush}">
<Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- 输入区 -->
                        <RowDefinition Height="*" />      <!-- 贴图类型清单 -->
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                    <TextBlock FontWeight="SemiBold" FontSize="14" Text="第一步 · 选择目标" />
                    <TextBlock Margin="0,4,0,14" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               Text="资产文件夹是扫描贴图的来源（可直接把文件夹拖进本窗口）；项目文件夹是 .vmat 的输出位置。贴图路径按相对资产根写入，因此两者可以分开。" />
                    <TextBlock Text="目标着色器" FontWeight="SemiBold" />
                    <ComboBox Margin="0,6,0,0" MinWidth="420" HorizontalAlignment="Left"
                              ItemsSource="{Binding Shaders}"
                              SelectedItem="{Binding SelectedShader, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Margin="0,16,0,0" Text="资产文件夹（贴图来源）" FontWeight="SemiBold" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding AssetsRoot, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,4"
                                Content="浏览…" Command="{Binding BrowseAssetsCommand}" />
                    </Grid>
                    <TextBlock Margin="0,16,0,0" Text="项目文件夹（.vmat 输出位置）" FontWeight="SemiBold" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ProjectRoot, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,4"
                                Content="浏览…" Command="{Binding BrowseProjectCommand}" />
                    </Grid>
                    <TextBlock Margin="0,16,0,0" FontSize="11" Opacity="0.7" TextWrapping="Wrap">
                        <Run Text="递归扫描子文件夹：" />
                        <Run Text="{Binding RecurseTextureFolders, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
</StackPanel>
                    <!-- 该着色器需要几类贴图、每类可能的后缀名。
                         这份清单只由着色器模板推出，与扫描无关，所以放在第一步：
                         选完着色器就能定下「要认哪些后缀」，再据此去准备资产。
                         之前它塞在第二步的工具条里，既放错了位置，
                         又把工具条撑成一个什么都装的杂物间。 -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
<TextBlock Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="{Binding InferredSummary}" />
                        <StackPanel Grid.Row="1" Margin="0,8,0,8" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.75"
                                       Text="后缀可直接改，多个用 | 分隔；勾选的行参与本次扫描。" />
                            <Button Margin="10,0,0,0" Padding="12,3" Content="把新增后缀加入规则表"
                                    Command="{Binding ApplyInferredSuffixesCommand}"
                                    ToolTip="把各行里规则表还没有的后缀并入规则表；点「保存设置」后写入注册表。不会覆盖你已经改过的内容。" />
                        </StackPanel>
                        <!-- 表头和数据行用的是同一套列宽，两处必须同步改，否则对不齐。
                             表头放在 ScrollViewer 内部（而不是外面固定），
                             这样内容被竖直滚动条挤窄的宽度与表头一致。 -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="10,0,10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="启用" />
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="贴图类型" />
                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="参数键" />
                                    <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="贴图后缀（| 分隔，可直接改）" />
                                    <TextBlock Grid.Column="4" Margin="0,0,4,0" HorizontalAlignment="Right"
                                               FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="新增" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding InferredSuffixes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="10,7" CornerRadius="4"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" MinWidth="16" Margin="0,0,12,0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled}"
                                                          IsEnabled="{Binding HasSuffixes}"
                                                          ToolTip="勾选后，这一行的后缀并入本次扫描" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding RoleDisplay, Mode=OneWay}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                           FontSize="11" Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding ParameterKey, Mode=OneWay}" />
                                                <!-- 后缀可编辑。失焦或回车才提交，避免每敲一个字符就重扫一遍。
                                                     竖线分隔是用户能直接打出来的符号，不用记特殊输入。 -->
                                                <TextBox Grid.Column="3" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" FontSize="12"
                                                         Text="{Binding SuffixText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="这一类贴图认哪些后缀。多个后缀用 | 分隔，例如 _base | _diffuse | _null" />
                                                <Border Grid.Column="4" Padding="6,1" CornerRadius="8"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFreshSuffixes}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10"
                                                               Text="{Binding FreshCount, Mode=OneWay, StringFormat='新增 {0}'}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Border>
        <!-- ─── 第二步：扫描列表 + 右侧预览 ───────────────────────────────── -->
        <Border Grid.Row="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StepIndex}" Value="2">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <!-- 扫描工具条。刻意用 ToolBar 而不是一摞手摆的 Border/StackPanel：
                         工具条就该长工具条的样子，按钮天然等高、间距一致，
                         将来加按钮只要再塞一个 Button，不必重排间距。 -->
<ToolBar Padding="6,4" Background="Transparent">
                        <!-- 换掉默认模板后，ItemsPresenter 会回退到竖向 StackPanel，
                             按钮会竖着排、Separator 还会被拉满整行。面板必须显式给横向；ToolBarPanel 的 Orientation 默认继承 Panel 的竖向，也要一起写。 -->
                        <ToolBar.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ToolBarPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ToolBar.ItemsPanel>
                        <ToolBar.Template>
                            <!-- 主题默认模板塞了两样这里用不上的东西：左侧 10px 的拖拽手柄
                                 （ToolBarThumb，里面 3px 竖虚线）和右侧的溢出箭头。
                                 手柄显式挂着主题 Style，资源键各主题还不一样，压不掉；
                                 与其和它较劲，不如给一份只含 ItemsPresenter 的模板，
                                 这样任何主题下都不会冒出来。 -->
                            <ControlTemplate TargetType="ToolBar">
                                <Border Background="{TemplateBinding Background}">
                                    <ItemsPresenter />
                                </Border>
                            </ControlTemplate>
                        </ToolBar.Template>
                        <ToolBar.Resources>
                            <!-- 分隔线给个明确模板：主题默认那条在浅色背景下几乎看不见。 -->
                            <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator">
                                <Setter Property="Margin" Value="7,4" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Width="1"
                                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToolBar.Resources>
                        <Button Padding="12,3" Content="扫描资产文件夹"
                                Command="{Binding ScanCommand}" />
                        <Separator />
                        <Button Padding="12,3" Content="按后缀重新扫描"
                                Command="{Binding RescanCommand}"
                                ToolTip="把第一步里推断出的、勾选中的新增后缀并入后重扫" />
                        <Separator />
                        <Button Padding="12,3" Content="还原自动归类"
                                Command="{Binding ResetManualGroupsCommand}"
                                ToolTip="清除所有手动指定的归属，回到按基名的自动分组" />
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="第二步 · 扫描与归类" />
                    </ToolBar>
                    <TextBlock Margin="10,4,0,0" FontSize="11" Opacity="0.75"
                               TextWrapping="Wrap" Text="{Binding ScanSummary}" />
                </StackPanel>
                <!-- 左：贴图列表；右：选中材质的 KeyValues1 预览 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="640" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" MinWidth="360" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="ScanGrid" Grid.Column="0"
                              ItemsSource="{Binding ScanRows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="56"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              FontSize="12">
                        <!-- 选中行的底色修复。WPF 内置的 DataGrid 行/格选中样式用系统色画选中带：
                             有焦点走 Highlight（亮蓝）、窗口失焦走 InactiveSelectionHighlight（浅灰白）。
                             深色主题下后者就是一条刺眼的白色横带，文字还同时变浅灰 —— 就是
                             「列表里多出一行白色」的成因。在表格自己的资源里覆盖这四个系统色键，
                             作用于表内所有画选中的地方（行带、单元格、单元格文字），
                             且随窗口焦点两种状态都用同一套深色主题色。 -->
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#663A7BD9" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#333A7BD9" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8E8E8" />
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="生成" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"
                                                  IsChecked="{Binding Include, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 缩略图直接绑 Thumbnail：该属性的 getter 会顺带发起解码，
                                 解完再抛一次 PropertyChanged 把图填上。
                                 配合 Recycling 虚拟化，只有滚进可视区的行才会被求值，
                                 成千上万行也只解看得见的那些。
                                 双击用系统默认程序打开原图。 -->
                            <DataGridTemplateColumn Header="预览" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Background="Transparent"
                                              ToolTip="{Binding FilePath}">
                                            <!-- Uniform = 整张缩到框内（适应大小），长宽比不变；
                                                 之前用 UniformToFill 会裁掉边缘，
                                                 而贴图往往正是靠边缘判断内容（法线的紫边、遮罩的构图）。 -->
                                            <Image Stretch="Uniform"
                                                   Source="{Binding Thumbnail}"
                                                   MouseLeftButtonDown="OnThumbnailMouseLeftButtonDown" />
                                            <TextBlock Text="?" FontSize="22" Opacity="0.35"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="文件" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 按参考文档的做法，对内容元素本身设对齐，而不是靠
                                             DataGridCell 的 HorizontalContentAlignment（会被列自带的
                                             ElementStyle / 模板根元素盖掉）。TextBlock 在 Measure 阶段
                                             仍收到可用宽度作为约束，所以 TextTrimming 照常生效。 -->
                                        <!-- 垂直 StackPanel 会忽略子元素的 VerticalAlignment，
                                             只按顺序堆叠。垂直居中必须加在 StackPanel 自己身上。 -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding FileName}" />
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="10" Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding RelativeDirectory}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="槽位" Width="214">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 槽位永远有值：未命中后缀规则的行由扫描侧默认 Color，
                                             不再有「未命中」空白态；默认来源由「写入」列的下划线箭头标出。 -->
                                        <Grid Margin="2">
                                            <!-- 候选项由 MainViewModel 按当前着色器算好推给每一行：
                                                 这个着色器没有的参数键根本不会出现在下拉框里。
                                                 选中项绑 SelectedRoleOption（共享实例）而不是裸槽位：
                                                 换着色器会整批换掉候选项，绑裸槽位时组合框在新列表里
                                                 比不中选中项，关闭态随即一片空白，像该行没加载出来。 -->
                                             <ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      FontSize="12"
                                                      ItemsSource="{Binding RoleOptions}"
                                                      SelectedItem="{Binding SelectedRoleOption, Mode=TwoWay}"
                                                      ToolTip="{Binding SelectedRoleOption.Note}"
                                                      DropDownOpened="OnRoleDropDownOpened">
                                                <!-- 单行双语。关闭态与下拉态共用同一个模板：
                                                     ComboBox.SelectionBoxItemTemplate 的 setter 是 internal，
                                                     设不了，没法让关闭态单独排成两行省列宽。
                                                     214px 装得下最长的「环境光遮蔽 (AmbientOcclusion)」
                                                     （文本 177px + 内边距 + 下拉箭头），固定列合计 540px，
                                                     窗口最窄 1060px 时「文件」列仍分到约 487px。 -->
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Display}" />
                                                            <!-- 第二行只在不受支持时出现（换过着色器的老归类）。
                                                                 行高 56px 摆得下两行，下拉列表里也只有这一项会长。
                                                                 文案用 ShortWarning 而不是 Note：这一列只有 214px，
                                                                 整句说明会被硬裁在中间，比不显示更糟，
                                                                 完整解释留给鼠标悬停的 ToolTip。
                                                                 整行必须靠触发器折叠——空的 TextBlock
                                                                 仍占一行高度，会把上面的主文案顶得偏上。 -->
                                                            <TextBlock FontSize="10" Opacity="0.65"
                                                                       Text="{Binding ShortWarning}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 命中反馈列：只有一个方向朝右的箭头，读作「本行写往右侧的
                                 『输出的 .vmat 文件名』列」——目标名就在右边格子里，箭头旁不再重复。
                                 未命中默认 Color 的行箭头带下划线，做最轻量的区分。 -->
                            <DataGridTemplateColumn Header="写入" Width="48" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="→" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   ToolTip="写入右侧『输出的 .vmat 文件名』列所示材质">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MatchedByRule}" Value="False">
                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                            <Setter Property="ToolTip"
                                                                    Value="未命中后缀规则，默认 Color 槽位；写入右侧所示材质" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 归属可改：同一张贴图被两个材质共用时，不必去动后缀规则。
                                 格子里写的是第三步真正写出的 .vmat 文件名（带扩展名），
                                 编辑提交时扩展名会被剥掉再存进分组名，见 VmatFileName。
                                 组合框候选 = 该行贴图所在文件夹下实际存在的全部 .vmat 文件，
                                 用户也可以直接输入一个新名字——给新材质添第一张贴图就走这条路。 -->
                            <DataGridTemplateColumn Header="输出的 .vmat 文件名" Width="168">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="2,0" FontSize="12"
                                                  IsEditable="True"
                                                  StaysOpenOnEdit="True"
                                                  IsTextSearchEnabled="False"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  Text="{Binding VmatFileName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                  ItemsSource="{Binding MaterialNameOptions}"
                                                  ToolTip="这份贴图写进哪个 .vmat。下拉里是这张贴图所在文件夹里现有的 .vmat 文件，也可以直接输入新名字；.vmat 扩展名会自动保留，清空则恢复到自动归类的基名。" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  ResizeDirection="Columns"
                                  Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                  Cursor="SizeWE"
                                  ToolTip="拖动调整列表与预览的宽度" />
                    <Border Grid.Column="2" Margin="6,0,0,0" Padding="12" CornerRadius="6"
                            Background="{DynamicResource LayerFillColorAltBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold"
                                       Text="{Binding SelectedRow.GroupName, StringFormat=选中材质：{0}.vmat}" />
                            <TextBlock DockPanel.Dock="Top" Margin="0,4,0,8" FontSize="11" Opacity="0.7"
                                       TextWrapping="Wrap"
                                       Text="这就是第三步将写出的完整内容。走的是同一条生成路径，因此预览与实际结果一致。" />
                            <TextBox IsReadOnly="True"
                                     FontFamily="Cascadia Mono, Consolas, 微软雅黑"
                                     FontSize="11"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="{Binding SelectedPreview, Mode=OneWay}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <!-- ─── 第三步：生成进度 ─────────────────────────────────────────── -->
        <Border Grid.Row="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StepIndex}" Value="3">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Padding="20" CornerRadius="6" Background="{DynamicResource LayerFillColorAltBrush}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" FontSize="14" Text="第三步 · 生成" />
                    <TextBlock Margin="0,4,0,18" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                               Text="按第二步确认的归属写出 .vmat。同名文件已存在时直接覆盖。生成期间界面不会卡死，可随时取消。" />
                    <ProgressBar Height="10" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" Text="{Binding ProgressMessage}" />
                    <TextBlock Margin="0,14,0,0" FontSize="11" Opacity="0.75"
                               TextWrapping="Wrap" Text="{Binding BuildSummary}" />
                </StackPanel>
            </Border>
        </Border>
        <!-- ─── 底部导航 ──────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!-- 保存设置放在常驻底栏：三步都要用到（着色器与目录在第一步改，
                     后缀规则在第一步之外的界面里也能动），原先只挂在第一步面板里，
                     后两步根本够不着。 -->
                <Button Margin="0,0,16,0" Padding="16,5" FontWeight="SemiBold"
                        Content="保存设置"
                        Command="{Binding SaveSettingsCommand}"
                        ToolTip="保存着色器、资产/项目文件夹与后缀规则" />
                <Button Margin="8,0,0,0" Padding="16,5" Content="取消生成"
                        Command="{Binding CancelGenerationCommand}">
                    <!-- 生成中才显示；用 DataTrigger 而不是 BooleanToVisibility 资源，
                         免得在 Window.Resources 里为一个布尔值再占一个键。 -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="8,0,0,0" Padding="16,5" Content="上一步"
                        Command="{Binding GoToPreviousStepCommand}">
                    <!-- 同样只在第一步时隐藏；CanExecute 再兜一层，生成中一律禁掉。 -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StepIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="8,0,0,0" Padding="16,5" Content="下一步"
                        Command="{Binding GoToNextStepCommand}">
                    <!-- 第三步没有「下一步」可走，位置让给「开始生成」。 -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StepIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="8,0,0,0" Padding="16,5" FontWeight="SemiBold" Content="开始生成"
                        IsEnabled="{Binding CanStartGenerate}"
                        Command="{Binding GenerateCommand}"
                        ToolTip="按当前分组与规则表生成 .vmat；已存在的文件直接覆盖">
                    <!-- 只在第三步出现。生成是个不可轻率的写盘动作，
                         放在第一步、第二步就意味着用户还没看扫描结果就能直接落盘；
                         而「下一步」正是第三步的出口，两者互斥，所以这里和它用同一个条件。 -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StepIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 输出文件夹入口常驻底栏最右侧，但只在「生成完成过」之后才可点：
                     CanOpenOutputFolder 要求存在一次成功写盘的目录快照，
                     没生成过（或正在生成中）时按钮是灰的，点了也不会扑空。 -->
                <Button Margin="8,0,0,0" Padding="16,5" Content="打开输出文件夹"
                        IsEnabled="{Binding CanOpenOutputFolder}"
                        Command="{Binding OpenOutputFolderCommand}"
                        ToolTip="在资源管理器中打开 .vmat 的输出目录（生成完成后才可点）" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <StackPanel>
                    <TextBlock FontSize="11" Opacity="0.7"
                               Text="{Binding StepIndex, StringFormat=当前步骤 {0}/3}" />
                    <!-- 状态行放在底栏而非第一步：保存设置现在三步都能点，反馈也必须三步都看得见。 -->
                    <TextBlock Margin="0,3,16,0" MaxWidth="620" FontSize="11" Opacity="0.8"
                               TextWrapping="Wrap" Text="{Binding StatusMessage}" />
                </StackPanel>
                <!-- 非阻塞错误角标：控件出错只在这里提示，不弹模态框（详见 App 的 Dispatcher 拦截）。 -->
                <Button x:Name="ErrorBanner" VerticalAlignment="Bottom" Margin="0,0,12,0"
                        Padding="8,2" FontSize="11" Foreground="#FFC42B1C"
                        Visibility="Collapsed" Click="OnShowErrorLogClicked"
                        Content="⚠ 0 个错误" ToolTip="点击查看错误日志" />
            </StackPanel>
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
